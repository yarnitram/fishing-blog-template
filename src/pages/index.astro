---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AdBanner from '../components/AdBanner.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col">
		<Header />
		
		<main class="w-full max-w-4xl mx-auto px-4 py-8 flex-1">
			<!-- Hero Section -->
			<div class="py-10 px-6 sm:px-10 rounded-3xl bg-gradient-to-br from-slate-900 via-teal-950 to-slate-900 text-white shadow-xl mb-10 border border-slate-800">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 text-xs font-semibold mb-4 border border-teal-500/30">
					<span>🎣 Field-Tested Kayak Fishing Reviews</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 leading-tight">
					Rig Smarter. Catch Bigger.
				</h1>
				<p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed mb-6">
					Unbiased, hands-on tests of the best pedal kayaks, sonar systems, trolling motors, and tackle rigging. Built by anglers, for anglers.
				</p>

				<!-- Category Pills -->
				<div class="flex flex-wrap gap-2 text-xs font-semibold">
					<span class="px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700 text-slate-200">
						🛶 Pedal Kayaks
					</span>
					<span class="px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700 text-slate-200">
						📡 Fish Finders & Sonar
					</span>
					<span class="px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700 text-slate-200">
						⚡ Lithium Rigging
					</span>
					<span class="px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700 text-slate-200">
						🌊 Saltwater & Inshore
					</span>
				</div>
			</div>

			<AffiliateDisclosure />

			<!-- Featured Articles Section -->
			<div class="space-y-6">
				<div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
					<h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
						Featured Buyer's Guides & Reviews
					</h2>
					<a href="/blog" class="text-xs font-semibold text-teal-600 dark:text-teal-400 hover:underline">
						View All Articles →
					</a>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{posts.map((post) => (
						<article class="flex flex-col justify-between p-5 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:border-teal-500/50 transition-all dark:bg-slate-900 dark:border-slate-800">
							<div>
								<div class="text-xs text-slate-500 dark:text-slate-400 mb-2">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3 class="text-lg font-bold text-slate-900 dark:text-white hover:text-teal-600 dark:hover:text-teal-400 transition-colors">
									<a href={`/blog/${post.id}/`}>
										{post.data.title}
									</a>
								</h3>
								<p class="text-xs text-slate-600 dark:text-slate-400 mt-2 line-clamp-3 leading-relaxed">
									{post.data.description}
								</p>
							</div>

							<div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
								<span class="text-[11px] font-semibold text-teal-600 dark:text-teal-400">
									Affiliate Review • Tested
								</span>
								<a
									href={`/blog/${post.id}/`}
									class="text-xs font-bold text-slate-900 dark:text-white hover:underline flex items-center gap-1"
								>
									<span>Read Guide</span>
									<span>→</span>
								</a>
							</div>
						</article>
					))}
				</div>
			</div>

			<AdBanner slotName="Home Bottom Leaderboard" />
		</main>

		<Footer />
	</body>
</html>
