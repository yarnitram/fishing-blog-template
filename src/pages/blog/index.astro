---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import AdBanner from '../../components/AdBanner.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const otherPosts = posts.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Gear Reviews & Field Guides - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 text-slate-950 min-h-screen flex flex-col font-sans antialiased">
		<Header />

		<main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-10 flex-1 space-y-10">
			<!-- Page Header -->
			<div class="space-y-3 max-w-2xl">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-100 border border-teal-300 text-teal-900 text-xs font-black uppercase tracking-wider">
					<span>Expert Testing & Buyer's Guides</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-black text-slate-950 tracking-tight">
					Kayak Fishing Reviews
				</h1>
				<p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed">
					Real-world field ratings, on-the-water performance metrics, and comparison breakdowns to help you pick the right gear.
				</p>
			</div>

			<AffiliateDisclosure />

			<!-- Featured Article Hero Card (if exists) -->
			{featuredPost && (
				<div class="rounded-3xl bg-white border-2 border-slate-300 shadow-sm hover:shadow-md transition-shadow overflow-hidden grid grid-cols-1 lg:grid-cols-12 gap-0">
					<div class="lg:col-span-7 bg-slate-100 flex items-center justify-center overflow-hidden min-h-[280px]">
						{featuredPost.data.heroImage && (
							<img
								src={typeof featuredPost.data.heroImage === 'string' ? featuredPost.data.heroImage : featuredPost.data.heroImage.src}
								alt={featuredPost.data.title}
								class="w-full h-full object-cover min-h-[300px] max-h-[420px]"
							/>
						)}
					</div>
					<div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between space-y-6">
						<div class="space-y-3">
							<div class="flex items-center gap-2 text-xs font-bold text-teal-900">
								<span class="px-2.5 py-0.5 rounded-full bg-teal-100 border border-teal-300 font-black">
									Featured Review
								</span>
								<span class="text-slate-400">•</span>
								<span class="text-slate-700 font-bold">
									<FormattedDate date={featuredPost.data.pubDate} />
								</span>
							</div>

							<h2 class="text-2xl sm:text-3xl font-black text-slate-950 leading-tight hover:text-teal-700 transition-colors">
								<a href={`/blog/${featuredPost.id}/`}>
									{featuredPost.data.title}
								</a>
							</h2>

							<p class="text-sm text-slate-700 font-medium leading-relaxed line-clamp-3">
								{featuredPost.data.description}
							</p>
						</div>

						<div>
							<a
								href={`/blog/${featuredPost.id}/`}
								class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-black text-xs bg-slate-950 hover:bg-teal-700 text-white shadow-xs transition-colors"
							>
								<span>Read Full Guide & Ratings</span>
								<span>→</span>
							</a>
						</div>
					</div>
				</div>
			)}

			<!-- All Guides Grid & Category Filter -->
			<div class="space-y-6 pt-6">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b-2 border-slate-200 pb-4">
					<div>
						<h2 class="text-xl font-black text-slate-950">All Testing Guides & Articles</h2>
						<p class="text-xs text-slate-600 font-medium mt-0.5">Filter by gear category or rigging topic</p>
					</div>
					<span id="guide-count" class="text-xs text-slate-700 font-bold bg-slate-200 px-3 py-1 rounded-full w-fit">
						{otherPosts.length} Guides Shown
					</span>
				</div>

				<!-- Category Filter Pills -->
				<div class="flex flex-wrap gap-2" id="category-filters">
					<button
						type="button"
						data-filter="all"
						class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-slate-950 text-white shadow-xs"
					>
						All Guides
					</button>
					<button
						type="button"
						data-filter="pedal-kayaks"
						class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-white text-slate-700 border-2 border-slate-200 hover:border-teal-500 hover:text-teal-900"
					>
						🛶 Pedal Kayaks
					</button>
					<button
						type="button"
						data-filter="electronics"
						class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-white text-slate-700 border-2 border-slate-200 hover:border-teal-500 hover:text-teal-900"
					>
						📡 Sonar & Electronics
					</button>
					<button
						type="button"
						data-filter="trolling-motors"
						class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-white text-slate-700 border-2 border-slate-200 hover:border-teal-500 hover:text-teal-900"
					>
						⚡ Trolling Motors
					</button>
					<button
						type="button"
						data-filter="safety-rigging"
						class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-white text-slate-700 border-2 border-slate-200 hover:border-teal-500 hover:text-teal-900"
					>
						🦺 Safety & Rigging
					</button>
					<button
						type="button"
						data-filter="inshore-tactics"
						class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-white text-slate-700 border-2 border-slate-200 hover:border-teal-500 hover:text-teal-900"
					>
						🌊 Inshore Tactics
					</button>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="articles-grid">
					{otherPosts.map((post) => (
						<article
							data-category={post.data.category || 'kayak-reviews'}
							class="article-card flex flex-col justify-between rounded-2xl bg-white border-2 border-slate-200 shadow-xs hover:shadow-md hover:border-teal-600 transition-all overflow-hidden group"
						>
							<div>
								{post.data.heroImage && (
									<a href={`/blog/${post.id}/`} class="block overflow-hidden h-48 bg-slate-100 relative">
										<img
											src={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src}
											alt={post.data.title}
											class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
											loading="lazy"
										/>
										<div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
									</a>
								)}

								<div class="p-6 space-y-3">
									<div class="flex items-center justify-between text-xs text-slate-700">
										<span class="font-black text-teal-800 uppercase tracking-wider text-[11px]">
											Buyer's Guide
										</span>
										<span class="font-bold">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>

									<h3 class="text-lg font-black text-slate-950 group-hover:text-teal-700 transition-colors leading-snug">
										<a href={`/blog/${post.id}/`}>
											{post.data.title}
										</a>
									</h3>

									<p class="text-xs text-slate-700 font-medium leading-relaxed line-clamp-3">
										{post.data.description}
									</p>
								</div>
							</div>

							<div class="px-6 py-3.5 bg-slate-100 border-t border-slate-200 flex items-center justify-between text-xs">
								<span class="font-bold text-slate-700">Field Rated</span>
								<a
									href={`/blog/${post.id}/`}
									class="font-black text-teal-800 group-hover:text-teal-950 flex items-center gap-1"
								>
									<span>Read Review</span>
									<span>→</span>
								</a>
							</div>
						</article>
					))}
				</div>
			</div>

			<AdBanner slotName="Blog Archive Footer Unit" />
		</main>

		<Footer />

		<script>
			function initCategoryFilters() {
				const buttons = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');
				const cards = document.querySelectorAll<HTMLElement>('.article-card');
				const countDisplay = document.getElementById('guide-count');

				function setFilter(filter: string) {
					let visibleCount = 0;

					cards.forEach((card) => {
						const cardCategory = card.dataset.category;
						if (filter === 'all' || cardCategory === filter) {
							card.style.display = 'flex';
							visibleCount++;
						} else {
							card.style.display = 'none';
						}
					});

					if (countDisplay) {
						countDisplay.textContent = `${visibleCount} Guides Shown`;
					}

					buttons.forEach((btn) => {
						const isMatch = btn.dataset.filter === filter;
						if (isMatch) {
							btn.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-slate-950 text-white shadow-xs';
						} else {
							btn.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-white text-slate-700 border-2 border-slate-200 hover:border-teal-500 hover:text-teal-900';
						}
					});
				}

				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						const f = btn.dataset.filter || 'all';
						setFilter(f);
						const url = new URL(window.location.href);
						if (f === 'all') {
							url.searchParams.delete('category');
						} else {
							url.searchParams.set('category', f);
						}
						window.history.replaceState({}, '', url.toString());
					});
				});

				// Check initial URL param
				const params = new URLSearchParams(window.location.search);
				const initialCategory = params.get('category');
				if (initialCategory) {
					setFilter(initialCategory);
				}
			}

			initCategoryFilters();
			document.addEventListener('astro:page-load', initCategoryFilters);
		</script>
	</body>
</html>
