---
import { SITE_TITLE } from '../consts';
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/90 border-b border-slate-200/80 shadow-xs">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
		<!-- Brand Logo -->
		<a href="/" class="flex items-center gap-2.5 group">
			<div class="w-10 h-10 rounded-xl bg-teal-600 text-white flex items-center justify-center font-bold text-lg shadow-sm shadow-teal-900/20 group-hover:bg-teal-500 transition-colors">
				🎣
			</div>
			<div>
				<span class="font-extrabold text-slate-900 text-lg tracking-tight group-hover:text-teal-600 transition-colors block leading-none">
					{SITE_TITLE}
				</span>
				<span class="text-[11px] font-semibold text-teal-600 tracking-wider uppercase block mt-1">
					Kayak Rigging & Reviews
				</span>
			</div>
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden md:flex items-center gap-1 text-sm font-semibold text-slate-600">
			<a
				href="/"
				class={`px-3.5 py-2 rounded-lg transition-colors ${
					pathname === '/' ? 'text-teal-700 bg-teal-50 font-bold' : 'hover:text-slate-900 hover:bg-slate-100'
				}`}
			>
				Home
			</a>
			<a
				href="/blog"
				class={`px-3.5 py-2 rounded-lg transition-colors ${
					pathname.startsWith('/blog') ? 'text-teal-700 bg-teal-50 font-bold' : 'hover:text-slate-900 hover:bg-slate-100'
				}`}
			>
				Gear Reviews
			</a>
			<a
				href="/tools/kayak-finder"
				class={`px-3.5 py-2 rounded-lg transition-colors ${
					pathname.startsWith('/tools/kayak-finder') ? 'text-teal-700 bg-teal-50 font-bold' : 'hover:text-slate-900 hover:bg-slate-100'
				}`}
			>
				🎯 Matchmaker
			</a>
			<a
				href="/tools/kayak-specs-matrix"
				class={`px-3.5 py-2 rounded-lg transition-colors ${
					pathname.startsWith('/tools/kayak-specs-matrix') ? 'text-teal-700 bg-teal-50 font-bold' : 'hover:text-slate-900 hover:bg-slate-100'
				}`}
			>
				📊 Spec Matrix
			</a>
			<a
				href="/about"
				class={`px-3.5 py-2 rounded-lg transition-colors ${
					pathname === '/about' ? 'text-teal-700 bg-teal-50 font-bold' : 'hover:text-slate-900 hover:bg-slate-100'
				}`}
			>
				About Us
			</a>
		</nav>

		<!-- Right Action CTA -->
		<div class="flex items-center gap-3">
			<a
				href="/blog/best-fishing-kayaks-2026"
				class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-xs transition-all hover:scale-[1.02] active:scale-[0.98]"
			>
				<span>🔥 2026 Best Kayaks</span>
			</a>
		</div>
	</div>
</header>
