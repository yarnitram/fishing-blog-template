---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer class="bg-slate-900 text-slate-400 border-t border-slate-800 mt-20 pt-16 pb-12">
	<div class="max-w-6xl mx-auto px-4 sm:px-6">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
			<!-- Col 1: Brand & Mission -->
			<div class="md:col-span-2 space-y-4">
				<div class="flex items-center gap-2.5">
					<div class="w-9 h-9 rounded-xl bg-teal-500/20 text-teal-400 border border-teal-500/30 flex items-center justify-center font-bold text-base">
						🎣
					</div>
					<span class="font-bold text-white text-lg tracking-tight">
						{SITE_TITLE}
					</span>
				</div>
				<p class="text-sm text-slate-400 leading-relaxed max-w-md">
					We rigorously test pedal kayaks, sonar electronics, and rigging setups on lakes, rivers, and coastal chop. Our mission is to help anglers make confident, informed gear investments.
				</p>
				<div class="text-xs text-slate-500">
					All gear tested by active kayak tournament anglers.
				</div>
			</div>

			<!-- Col 2: Categories -->
			<div class="space-y-3">
				<h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">
					Gear Categories
				</h3>
				<ul class="text-sm space-y-2">
					<li>
						<a href="/blog/best-fishing-kayaks-2026" class="hover:text-teal-400 transition-colors">
							Pedal Kayaks
						</a>
					</li>
					<li>
						<a href="/blog/top-kayak-fish-finders-2026" class="hover:text-teal-400 transition-colors">
							Fish Finders & Sonar
						</a>
					</li>
					<li>
						<a href="/blog" class="hover:text-teal-400 transition-colors">
							Tackle Rigging & Safety
						</a>
					</li>
					<li>
						<a href="/blog" class="hover:text-teal-400 transition-colors">
							Buyer's Guides & Comparisons
						</a>
					</li>
				</ul>
			</div>

			<!-- Col 3: Legal & Trust -->
			<div class="space-y-3">
				<h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">
					Editorial & Trust
				</h3>
				<ul class="text-sm space-y-2">
					<li>
						<a href="/about" class="hover:text-teal-400 transition-colors">
							Testing Methodology
						</a>
					</li>
					<li>
						<a href="/about" class="hover:text-teal-400 transition-colors">
							Editorial Independence
						</a>
					</li>
					<li>
						<a href="/about" class="hover:text-teal-400 transition-colors">
							Affiliate Policy
						</a>
					</li>
					<li>
						<a href="/about" class="hover:text-teal-400 transition-colors">
							Contact & Gear Submissions
						</a>
					</li>
				</ul>
			</div>
		</div>

		<!-- Bottom Copyright & FTC Disclosure -->
		<div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
			<p>
				&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
			</p>
			<p class="max-w-xl text-center md:text-right leading-relaxed text-[11px]">
				Disclaimer: As an Amazon Associate and Bass Pro Shops affiliate partner, we earn from qualifying purchases at zero added cost to you.
			</p>
		</div>
	</div>
</footer>
