---
interface Props {
  slotName?: string;
  adHtml?: string;
}

const { slotName = 'In-Article Sponsor', adHtml } = Astro.props;
---

<div class="my-8 p-4 rounded-xl border-2 border-dashed border-slate-300 bg-slate-100/90 text-center">
  <div class="text-[10px] font-black uppercase tracking-widest text-slate-600 mb-2">
    ADVERTISEMENT • {slotName}
  </div>

  {adHtml ? (
    <div set:html={adHtml} />
  ) : (
    <div class="py-6 px-4 flex flex-col items-center justify-center text-xs text-slate-700">
      <span class="font-bold text-slate-800">Ad Placement Container</span>
      <span class="text-[11px] text-slate-600 mt-1">
        (Reserved for Google AdSense, Mediavine, or high-converting affiliate banners)
      </span>
    </div>
  )}
</div>
