---
interface Props {
  slotName?: string;
  adHtml?: string;
}

const { slotName = 'In-Article Sponsor', adHtml } = Astro.props;
---

<div class="my-8 p-4 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50 text-center">
  <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2">
    ADVERTISEMENT • {slotName}
  </div>

  {adHtml ? (
    <div set:html={adHtml} />
  ) : (
    <div class="py-6 px-4 flex flex-col items-center justify-center text-xs text-slate-400">
      <span class="font-medium">Ad Network Slot Reserved</span>
      <span class="text-[11px] text-slate-500 mt-1">
        (Supports Google AdSense, Mediavine, or custom affiliate banner scripts)
      </span>
    </div>
  )}
</div>
