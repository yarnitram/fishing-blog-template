---
interface Props {
  title: string;
  badge?: string;
  category?: string;
  rating?: number | string;
  price?: string;
  imageUrl?: string;
  affiliateUrl: string;
  ctaText?: string;
  pros?: string[];
  cons?: string[];
}

const {
  title,
  badge = 'Top Recommendation',
  category = 'Fishing Gear',
  rating = '4.9',
  price = 'Check Price',
  imageUrl,
  affiliateUrl,
  ctaText = 'Check Price on Amazon',
  pros = [],
  cons = [],
} = Astro.props;
---

<div class="my-8 rounded-2xl bg-white border-2 border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow dark:bg-slate-900 dark:border-slate-800">
  <!-- Top Badge Bar -->
  <div class="bg-gradient-to-r from-teal-600 to-emerald-600 px-6 py-2.5 text-white flex items-center justify-between">
    <span class="text-xs font-bold uppercase tracking-wider">{badge}</span>
    <span class="text-xs font-semibold flex items-center gap-1">
      ⭐ {rating} / 5.0
    </span>
  </div>

  <div class="p-6 md:p-8">
    <div class="flex flex-col md:flex-row gap-6 items-center md:items-start">
      <!-- Product Image -->
      {imageUrl && (
        <div class="w-full md:w-56 h-52 shrink-0 rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
          <img
            src={imageUrl}
            alt={title}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      )}

      <!-- Details -->
      <div class="flex-1 w-full space-y-4">
        <div>
          <span class="text-xs font-semibold text-teal-600 dark:text-teal-400 uppercase tracking-wider">
            {category}
          </span>
          <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mt-1">
            {title}
          </h3>
          <div class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">
            {price}
          </div>
        </div>

        <!-- Pros & Cons Grid -->
        {(pros.length > 0 || cons.length > 0) && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            {pros.length > 0 && (
              <div class="space-y-1.5 p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/30">
                <span class="text-xs font-bold text-emerald-800 dark:text-emerald-300">✅ Pros</span>
                <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-1">
                  {pros.map((p) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-emerald-500 font-bold">•</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {cons.length > 0 && (
              <div class="space-y-1.5 p-3 rounded-xl bg-rose-50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/30">
                <span class="text-xs font-bold text-rose-800 dark:text-rose-300">❌ Cons</span>
                <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-1">
                  {cons.map((c) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-rose-500 font-bold">•</span>
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        <!-- High-converting CTA Button -->
        <div class="pt-3">
          <a
            href={affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 shadow-md shadow-orange-950/20 hover:scale-[1.01] active:scale-[0.99] transition-all"
          >
            <span>{ctaText}</span>
            <span class="ml-2 font-bold">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
