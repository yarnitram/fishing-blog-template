---
interface Props {
  title: string;
  badge?: string;
  category?: string;
  rating?: number | string;
  price?: string;
  imageUrl?: string;
  affiliateUrl: string;
  ctaText?: string;
  pros?: string[];
  cons?: string[];
}

const {
  title,
  badge = 'Top Recommendation',
  category = 'Fishing Gear',
  rating = '4.9',
  price = 'Check Price',
  imageUrl,
  affiliateUrl,
  ctaText = 'Check Price on Amazon',
  pros = [],
  cons = [],
} = Astro.props;
---

<div class="my-8 rounded-2xl bg-white border-2 border-slate-300 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
  <!-- Top Badge Bar -->
  <div class="bg-gradient-to-r from-teal-700 to-emerald-700 px-6 py-2.5 text-white flex items-center justify-between">
    <span class="text-xs font-black uppercase tracking-wider">{badge}</span>
    <span class="text-xs font-bold flex items-center gap-1 bg-teal-800/60 px-2 py-0.5 rounded">
      ⭐ {rating} / 5.0
    </span>
  </div>

  <div class="p-6 md:p-8">
    <div class="flex flex-col md:flex-row gap-6 items-center md:items-start">
      <!-- Product Image -->
      {imageUrl && (
        <div class="w-full md:w-56 h-52 shrink-0 rounded-xl overflow-hidden bg-slate-100 border border-slate-300">
          <img
            src={imageUrl}
            alt={title}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      )}

      <!-- Details -->
      <div class="flex-1 w-full space-y-4">
        <div>
          <span class="text-xs font-bold text-teal-800 uppercase tracking-wider">
            {category}
          </span>
          <h3 class="text-xl md:text-2xl font-black text-slate-950 mt-1 leading-snug">
            {title}
          </h3>
          <div class="text-xl font-black text-emerald-700 mt-1">
            {price}
          </div>
        </div>

        <!-- Pros & Cons Grid -->
        {(pros.length > 0 || cons.length > 0) && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            {pros.length > 0 && (
              <div class="space-y-1.5 p-3.5 rounded-xl bg-emerald-50/90 border border-emerald-300">
                <span class="text-xs font-black text-emerald-950 flex items-center gap-1">
                  ✅ Key Pros
                </span>
                <ul class="text-xs text-slate-900 space-y-1 font-medium">
                  {pros.map((p) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-emerald-700 font-bold">•</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {cons.length > 0 && (
              <div class="space-y-1.5 p-3.5 rounded-xl bg-rose-50/90 border border-rose-300">
                <span class="text-xs font-black text-rose-950 flex items-center gap-1">
                  ❌ Drawbacks
                </span>
                <ul class="text-xs text-slate-900 space-y-1 font-medium">
                  {cons.map((c) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-rose-700 font-bold">•</span>
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        <!-- High-converting CTA Button -->
        <div class="pt-3">
          <a
            href={affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-3.5 rounded-xl font-black text-sm bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-md hover:scale-[1.01] active:scale-[0.99] transition-all"
          >
            <span>{ctaText}</span>
            <span class="ml-2 font-bold">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
