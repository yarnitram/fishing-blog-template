---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AdBanner from '../components/AdBanner.astro';
import JsonLd from '../components/JsonLd.astro';
import StickyMobileCta from '../components/StickyMobileCta.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	rating,
	topPickName,
	topPickUrl,
	topPickPrice,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={title} description={description} />
		<JsonLd
			title={title}
			description={description}
			pubDate={pubDate}
			updatedDate={updatedDate}
			heroImage={heroImage}
			rating={rating}
			topPickName={topPickName}
			topPickPrice={topPickPrice}
		/>
	</head>

	<body class="bg-slate-50 text-slate-950 antialiased min-h-screen flex flex-col font-sans">
		<Header />

		<main class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-8 flex-1">
			<!-- Breadcrumbs -->
			<nav class="flex items-center gap-2 text-xs text-slate-700 mb-6 font-semibold">
				<a href="/" class="hover:text-teal-700 transition-colors">Home</a>
				<span class="text-slate-400">/</span>
				<a href="/blog" class="hover:text-teal-700 transition-colors">Gear Reviews</a>
				<span class="text-slate-400">/</span>
				<span class="text-slate-950 font-bold truncate max-w-xs">{title}</span>
			</nav>

			<article>
				<!-- Article Header -->
				<header class="space-y-4 mb-8">
					<div class="flex items-center gap-2.5">
						<span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-teal-100 text-teal-900 border border-teal-300">
							Field-Tested Review
						</span>
						<span class="text-xs text-slate-700 flex items-center gap-1 font-bold">
							🕒 7 Min Read
						</span>
					</div>

					<h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-950 leading-[1.15]">
						{title}
					</h1>

					<p class="text-lg text-slate-700 font-medium leading-relaxed max-w-3xl">
						{description}
					</p>

					<!-- Author & Date Meta -->
					<div class="flex items-center gap-3 pt-4 border-t-2 border-slate-200 text-xs text-slate-700">
						<div class="w-9 h-9 rounded-full bg-teal-700 text-white font-black flex items-center justify-center text-xs">
							RY
						</div>
						<div>
							<div class="font-extrabold text-slate-950">Rigged Yak Testing Crew</div>
							<div class="text-[11px] text-slate-600 font-semibold">
								Published <FormattedDate date={pubDate} />
								{updatedDate && <span> • Updated on <FormattedDate date={updatedDate} /></span>}
							</div>
						</div>
					</div>
				</header>

				<!-- Hero Image -->
				{heroImage && (
					<div class="mb-8 rounded-2xl overflow-hidden border-2 border-slate-300 shadow-md">
						<img
							src={typeof heroImage === 'string' ? heroImage : heroImage.src}
							alt={title}
							class="w-full h-auto max-h-[480px] object-cover"
						/>
					</div>
				)}

				<!-- FTC Affiliate Disclosure -->
				<AffiliateDisclosure />

				<!-- Article Body -->
				<div class="prose-modern max-w-none">
					<slot />
				</div>

				<!-- In-Article Ad Unit -->
				<AdBanner slotName="Post Content Footer" />

				<!-- Author Bio Box -->
				<div class="mt-12 p-6 rounded-2xl bg-white border-2 border-slate-300 shadow-xs flex flex-col sm:flex-row items-center gap-5">
					<div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-teal-600 to-emerald-700 text-white font-black text-xl flex items-center justify-center shrink-0 shadow-sm">
						🎣
					</div>
					<div class="space-y-1 text-center sm:text-left">
						<h3 class="text-base font-black text-slate-950">About the Rigged Yak Testing Crew</h3>
						<p class="text-xs text-slate-700 leading-relaxed font-medium">
							Our team has over 20 years of collective tournament and recreational kayak fishing experience. We purchase or field-test every hull, fish finder, and paddle in real water conditions before publishing ratings.
						</p>
					</div>
				</div>

				<!-- Back to Guides Button -->
				<div class="mt-8 pt-6 border-t-2 border-slate-200 flex items-center justify-between">
					<a
						href="/blog"
						class="inline-flex items-center gap-2 text-sm font-black text-teal-800 hover:text-teal-950 transition-colors"
					>
						<span>← Back to All Reviews & Guides</span>
					</a>
				</div>
			</article>
		</main>

		<Footer />
		<StickyMobileCta
			topPickName={topPickName}
			topPickUrl={topPickUrl}
			topPickPrice={topPickPrice}
		/>
	</body>
</html>
